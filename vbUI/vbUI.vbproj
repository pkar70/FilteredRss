<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
 <!-- osobna kompilacja dla 2.0 (UNO) oraz UAP (UWP), bo w ten sposób IntelliSense się ogranicza do 17763 -->
    <TargetFrameworks>uap10.0.19041;netstandard2.0</TargetFrameworks>
    <RootNamespace>FilteredRss</RootNamespace>
    <AssemblyName>FilteredRss.vbUI</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

<PropertyGroup Condition="'$(TargetFramework)' == 'uap10.0.19041'">
  <!-- Wymuszenie użycia Microsoft SDKs zamiast Windows Kits -->
  <TargetPlatformIdentifier>UAP</TargetPlatformIdentifier>
  <TargetPlatformVersion>10.0.19041.0</TargetPlatformVersion>
  <TargetPlatformMinVersion>10.0.15063.0</TargetPlatformMinVersion>

  <!-- Najważniejsze: ręczne wskazanie pełnych WinMD -->
  <WindowsSdkPath>C:\Program Files (x86)\Microsoft SDKs\UAP\10.0.19041.0\</WindowsSdkPath>
  <WindowsSdkDir>C:\Program Files (x86)\Microsoft SDKs\UAP\10.0.19041.0\</WindowsSdkDir>
</PropertyGroup>


  <!-- pakiety wspólne -->
  <ItemGroup>
    <!-- <PackageReference Include="Uno.UI" Version="5.1.0" /> -->
  </ItemGroup>

  <!-- Pakiety tylko dla Uno -->
  <ItemGroup Condition="'$(TargetFramework)'=='netstandard2.0'">
    <PackageReference Include="Uno.UI" Version="4.10.39" />
  </ItemGroup>

  <!-- Pakiety tylko dla UWP -->
  <ItemGroup Condition="'$(TargetFramework)'=='uap10.0.19041'">
    <PackageReference Include="CommunityToolkit.Uwp.Controls.Sizers">
      <Version>8.1.240916</Version>
    </PackageReference>
    <PackageReference Include="Microsoft.NETCore.UniversalWindowsPlatform">
      <Version>6.2.14</Version>
    </PackageReference>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications">
      <Version>7.1.2</Version>
    </PackageReference>
    <PackageReference Include="Microsoft.UI.Xaml">
      <Version>2.7.0</Version>
    </PackageReference>
    <PackageReference Include="pkar.UWP.Config">
      <Version>1.0.2</Version>
    </PackageReference>
    <PackageReference Include="pkar.Uwp.Extensions">
      <Version>2.0.13</Version>
    </PackageReference>
    <PackageReference Include="pkar.UWP.Triggers">
      <Version>1.2.0</Version>
    </PackageReference>
    <PackageReference Include="PlatformSpecific.Analyzer">
      <Version>2.0.3</Version>
    </PackageReference>
  </ItemGroup>



  <ItemGroup>
    <ProjectReference Include="..\vblib2\vblib2.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Umożliwia kompilację XAML w bibliotece -->
    <Page Include="**\*.xaml" />

    <!-- Localization -->
    <PRIResource Include="Strings\**\*.resw" />

    <!-- Static assets (help guide) -->
    <Content Include="Assets\**\*.htm">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  


</Project>
